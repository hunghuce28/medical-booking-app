@startuml Sodo_UseCase
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stick

' --- Cấu hình Làm Đẹp Sơ Đồ --- 
' Tăng khoảng cách các nốt để đường thẳng rộng rãi hơn
skinparam nodesep 20
skinparam ranksep 100

' Tô màu nền phân biệt và các đường nét
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor RoyalBlue
    ArrowColor DimGray
}

skinparam actor {
    BackgroundColor LightSkyBlue
    BorderColor DarkBlue
}

actor "Bệnh nhân\n(Patient)" as Patient
actor "Bác sĩ\n(Doctor)" as Doctor
actor "Quản trị viên\n(Admin)" as Admin

' Ép các Actor nằm theo chiều dọc để tránh chéo dây
Patient -[hidden]down-> Doctor
Doctor -[hidden]down-> Admin

rectangle "Hệ Thống Đặt Lịch Khám Bệnh Đa Nền Tảng" {

    package "Chức năng Cơ bản" {
        usecase "Đăng ký / Đăng nhập" as UC_Auth
        usecase "Quản lý hồ sơ cá nhân" as UC_Profile
    }

    package "Module Bệnh Nhân" {
        usecase "Tìm kiếm Bác sĩ / Chuyên khoa" as UC_Search
        usecase "Đặt lịch khám" as UC_Book
        usecase "Xem và Quản lý lịch hẹn" as UC_ManageAppt
        usecase "Xem kết quả/Lịch sử khám" as UC_History
        usecase "Đánh giá Bác sĩ" as UC_Review
    }

    package "Module Bác Sĩ" {
        usecase "Quản lý lịch làm việc (Ca khám)" as UC_DocSchedule
        usecase "Tiếp nhận / Từ chối lịch hẹn" as UC_DocAppt
        usecase "Cập nhật bệnh án (Chẩn đoán, Đơn thuốc)" as UC_MedRecord
    }
    
    package "Module Quản Trị Hệ Thống" {
        usecase "Quản lý danh sách Chuyên khoa" as UC_AdminSpec
        usecase "Quản lý danh sách Bác sĩ" as UC_AdminDoc
        usecase "Quản lý danh sách Bệnh nhân" as UC_AdminPat
        usecase "Xem thống kê / Báo cáo" as UC_Report
    }
}

' ================================
' CÁC ĐƯỜNG KẾT NỐI (RELATIONSHIPS)
' ================================

' Bệnh nhân
Patient --> UC_Auth
Patient --> UC_Profile
Patient --> UC_Book
Patient --> UC_Search
Patient --> UC_ManageAppt
Patient --> UC_History
Patient --> UC_Review

' Bác sĩ
Doctor ---> UC_Auth
Doctor ---> UC_Profile
Doctor ---> UC_DocSchedule
Doctor ---> UC_DocAppt
Doctor ---> UC_MedRecord

' Admin
Admin --> UC_Auth
Admin --> UC_AdminSpec
Admin --> UC_AdminDoc
Admin --> UC_AdminPat
Admin --> UC_Report

' ================================
' QUAN HỆ LOGIC MỞ RỘNG (INCLUDE / EXTEND)
' ================================
UC_Book ..> UC_Search : <<include>>
UC_ManageAppt ..> UC_Auth : <<include>>
UC_DocAppt ..> UC_Auth : <<include>>
UC_Review ..> UC_History : <<extend>>

@enduml
