// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================
// ENUMS
// ========================

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REJECTED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_REMINDER
  GENERAL
}

// ========================
// MODELS
// ========================

/// Bảng người dùng - lưu thông tin đăng nhập cho tất cả vai trò
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  avatar       String?
  role         Role     @default(PATIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  patient       Patient?
  doctor        Doctor?
  notifications Notification[]
  refreshTokens RefreshToken[]
  appointmentHistories AppointmentHistory[]

  @@map("users")
}

/// Bảng bệnh nhân - mở rộng thông tin y tế, liên kết 1:1 với users
model Patient {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?
  insuranceNumber String?
  bloodType      String?
  allergies      String?
  medicalHistory String?
  createdAt      DateTime  @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@map("patients")
}

/// Bảng chuyên khoa - danh mục các chuyên khoa y tế
model Specialty {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  doctors Doctor[]

  @@map("specialties")
}

/// Bảng bác sĩ - thông tin chi tiết, liên kết 1:1 với users
model Doctor {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  specialtyId     Int
  degree          String?
  description     String?
  experienceYears Int      @default(0)
  consultationFee Decimal  @default(0) @db.Decimal(10, 2)
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty    Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  schedules    DoctorSchedule[]
  timeSlots    TimeSlot[]
  appointments Appointment[]
  reviews      Review[]
  leaveRequests LeaveRequest[]

  @@index([specialtyId])
  @@map("doctors")
}

/// Bảng lịch làm việc - khung giờ cố định theo ngày trong tuần
model DoctorSchedule {
  id                  Int       @id @default(autoincrement())
  doctorId            Int
  dayOfWeek           DayOfWeek
  startTime           String    // "08:00"
  endTime             String    // "17:00"
  slotDurationMinutes Int       @default(30)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

/// Bảng khung giờ khám - slot cụ thể theo ngày
model TimeSlot {
  id        Int        @id @default(autoincrement())
  doctorId  Int
  date      DateTime   @db.Date
  startTime String     // "08:00"
  endTime   String     // "08:30"
  status    SlotStatus @default(AVAILABLE)

  // Relations
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([doctorId, date, startTime])
  @@map("time_slots")
}

/// Bảng lịch khám - cuộc hẹn khám bệnh
model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int
  doctorId        Int
  timeSlotId      Int               @unique
  appointmentDate DateTime          @db.Date
  status          AppointmentStatus @default(PENDING)
  symptoms        String?
  notes           String?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  timeSlot      TimeSlot       @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord?
  review        Review?
  histories     AppointmentHistory[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("appointments")
}

/// Bảng kết quả khám - chẩn đoán và đơn thuốc
model MedicalRecord {
  id            Int       @id @default(autoincrement())
  appointmentId Int       @unique
  diagnosis     String
  prescription  String?
  notes         String?
  followUpDate  DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  // Relations
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  attachments   Attachment[]

  @@map("medical_records")
}

/// Bảng đơn thuốc chi tiết - tách riêng từng loại thuốc kê đơn
model Prescription {
  id              Int      @id @default(autoincrement())
  medicalRecordId Int
  medicineName    String
  dosage          String   // "2 viên/ngày"
  frequency       String   // "Sáng - Tối"
  duration        String?  // "7 ngày"
  notes           String?
  createdAt       DateTime @default(now())

  // Relations
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

/// Bảng file đính kèm - kết quả xét nghiệm, ảnh chụp y khoa
model Attachment {
  id              Int      @id @default(autoincrement())
  medicalRecordId Int
  fileName        String
  fileUrl         String
  fileType        String   // "image", "pdf", "lab_result"
  description     String?
  createdAt       DateTime @default(now())

  // Relations
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

/// Bảng đánh giá - bệnh nhân đánh giá bác sĩ
model Review {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  patientId     Int
  doctorId      Int
  rating        Int      // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

/// Bảng thông báo - push notification cho người dùng
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

/// Bảng Refresh Token - lưu trữ token để hỗ trợ revoke và quản lý thiết bị
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  device    String?  // "iPhone 15", "Chrome Windows"
  ipAddress String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// Bảng Audit Log - ghi nhận mọi thao tác thay đổi dữ liệu y tế nhạy cảm
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGOUT
  entityType String   // Appointment, MedicalRecord, Doctor, User, etc.
  entityId   Int?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Bảng lịch sử thay đổi trạng thái cuộc hẹn
model AppointmentHistory {
  id              Int               @id @default(autoincrement())
  appointmentId   Int
  status          AppointmentStatus
  changedByUserId Int?
  note            String?
  createdAt       DateTime          @default(now())

  // Relations
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedByUser   User?             @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([changedByUserId])
  @@map("appointment_histories")
}

/// Bảng đăng ký nghỉ phép của bác sĩ
model LeaveRequest {
  id          Int         @id @default(autoincrement())
  doctorId    Int
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  status      LeaveStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  reason      String?
  createdAt   DateTime    @default(now())

  // Relations
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Bảng ngày nghỉ lễ
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}
